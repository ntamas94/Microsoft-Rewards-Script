# Copy to .env next to compose.yaml. Never commit the real values.

# Password for the "rewards" account inside the VM. Not your Microsoft password -
# this is only the local Windows login for the virtual machine.
WINDOWS_PASSWORD=

# Where the virtual disk lives on the host. Needs ~48GB.
WINDOWS_STORAGE_DIR=/mnt/hdd/windows-edge/storage

# Who can reach the VM viewer on :8006. It has no password, and it controls a Windows
# desktop signed into your Microsoft account. 127.0.0.1 = this server only (use an SSH
# tunnel); 0.0.0.0 = anyone on your LAN.
VIEWER_BIND=127.0.0.1
